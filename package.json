{
  "name": "eval-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evaluation Middle Platform · M1 核心底座与确定性评测闭环",
  "workspaces": [
    "contracts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "dev": "next dev -p 3000",
    "prebuild": "tsx scripts/check-next-artifacts.ts",
    "build": "next build",
    "clean:next": "tsx scripts/clean-next.ts",
    "check:next-artifacts": "tsx scripts/check-next-artifacts.ts",
    "check:datasets-render": "tsx scripts/check-datasets-render.ts",
    "start": "next start -p 3000",
    "worker": "tsx worker/index.ts",
    "fixture": "tsx tools/fixture-gateway/index.ts",
    "dev:all": "tsx scripts/dev-all.ts",
    "e2e": "tsx scripts/e2e-demo.ts",
    "e2e:fail": "tsx scripts/e2e-fail.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w @eval-platform/contracts",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"app/**/*.css\" \"components/**/*.css\"",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lint:design": "npm run lint && npm run lint:css && npm run check:tokens",
    "hooks:enable": "sh scripts/enable-hooks.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eval-platform/contracts": "*",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-table": "^8.20.6",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "echarts": "^5.6.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "p-limit": "^6.2.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.4.49",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
