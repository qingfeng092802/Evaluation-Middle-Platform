# ============================================================
#  Evaluation Middle Platform · 环境变量模板
#  复制为 .env 后按需修改。.env 永不入库（见 .gitignore）。
#  本文件只含占位值，不含任何真实凭据（docs/工程规则.md §9）。
# ============================================================

# 数据库连接串（docker compose 起的本地 PG 16）
DATABASE_URL=postgres://eval:eval_local_dev_only@127.0.0.1:5433/eval_platform
# 测试库连接串。真库测试（vitest）会自动改写 DATABASE_URL 指向它，库名默认在
# DATABASE_URL 的库名后加 `_test`（即 eval_platform_test），不存在时自动创建。
# 显式设置优先；**绝不能指向 dev 库** —— 测试会 dropAndRecreateSchema()，
# 与 dev:all 的常驻 worker 抢同一个队列（见 docs/工程规则.md §4.2、B-03/B-04）。
# TEST_DATABASE_URL=postgres://eval:eval_local_dev_only@127.0.0.1:5433/eval_platform_test

# 应用侧写入 created_by 的固定标识（M1 无登录体系）
APP_CREATED_BY=m1-local

# fixture 网关（M1 专用，M2 摘除默认路径）
FIXTURE_BASE_URL=http://127.0.0.1:8787
FIXTURE_PORT=8787
# 错误注入：timeout | 500 | 429；留空 = 正常回显。进程启动时读一次。
FIXTURE_FAIL_MODE=
# 慢速注入：每次响应前的 sleep 毫秒数，默认 0 关闭。
FIXTURE_DELAY_MS=0

# worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=200
WORKER_RECLAIM_INTERVAL_MS=60000
# 租约 TTL（PG interval 写法）。回收判定：GREATEST(started_at, heartbeat_at) < now() - TTL。
WORKER_STALE_AFTER=10 minutes
# 心跳间隔不单独配置：由 TTL 派生为 TTL/3（10 minutes ⇒ 200s）。
# 只配 TTL 是为了让「续约节奏」永远不可能比「回收阈值」更迟钝。
